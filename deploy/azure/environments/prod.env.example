# ==============================================================================
# Production Environment Configuration Template (Azure Cloud Native)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# Azure Infrastructure Identifiers
AZURE_SUBSCRIPTION_ID=670adf48-d3fc-4d03-b4e9-7f43f928e1cc
AZURE_RESOURCE_GROUP=rg-cloud-order-platform
AZURE_LOCATION=canadacentral
AZURE_CONTAINER_REGISTRY=cloudorderplatformacr.azurecr.io
AZURE_CONTAINER_APP_ENV=cloud-order-env

# Azure Managed Identity & Key Vault
AZURE_KEY_VAULT_NAME=kv-cloud-order-prod
AZURE_CLIENT_ID=managed-identity-client-id

# Azure Data Lake Storage Gen2 (Delta Lake)
ADLS_ACCOUNT_NAME=cloudorderadls01
ADLS_CONTAINER_BRONZE=bronze
ADLS_CONTAINER_SILVER=silver
ADLS_CONTAINER_GOLD=gold
ADLS_CONTAINER_QUARANTINE=quarantine

# Production Container App Endpoints (Internal VNet Ingress)
ML_SERVICE_URL=https://cloud-order-ml-service.nicesea-33749800.canadacentral.azurecontainerapps.io
INVENTORY_RISK_URL=https://cloud-order-inventory-risk.nicesea-33749800.canadacentral.azurecontainerapps.io
MONITORING_URL=https://cloud-order-ml-monitoring.nicesea-33749800.canadacentral.azurecontainerapps.io
RABBITMQ_URL=amqp://order_user:${RABBITMQ_PASSWORD}@cloud-order-rabbitmq.internal.nicesea-33749800.canadacentral.azurecontainerapps.io:5672/

# Production Model Governance & Registry
MODEL_NAME=demand_forecasting_xgboost
MODEL_VERSION=1
FEATURE_VERSION=v1
DATASET_VERSION=demand_features_v1
PSI_WARNING_THRESHOLD=0.10
PSI_CRITICAL_THRESHOLD=0.25
MAX_ACCEPTABLE_DEGRADATION_RATIO=1.50
