# ==============================================================================
# Development Environment Configuration Template (Local & Staging)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Microservices Network Endpoints
ORDER_SERVICE_URL=http://localhost:8000
GATEWAY_URL=http://localhost:8000
INVENTORY_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002
ML_SERVICE_URL=http://localhost:8004
INVENTORY_RISK_URL=http://localhost:8005
MONITORING_URL=http://localhost:8006

# Messaging & Storage Endpoints
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# Data Lakehouse (Local Fallback)
BRONZE_LAKE_PATH=./data/lake/bronze
SILVER_LAKE_PATH=./data/lake/silver
GOLD_LAKE_PATH=./data/lake/gold
QUARANTINE_LAKE_PATH=./data/lake/quarantine

# ML & Model Registry
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_NAME=demand_forecasting_xgboost
MODEL_VERSION=1
FEATURE_VERSION=v1
DATASET_VERSION=demand_features_v1
